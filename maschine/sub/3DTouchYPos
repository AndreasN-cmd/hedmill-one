(-------------------- 3D-Messpunkt X+ ermitteln ------------------)

(--Beschreibung-------------------------------------------------------------)
;  Mit diesem Programm wird ein Messpunkt mit dem 3D-Taster in 
;  positiver Y-Richtung bestimmt
;
;	Version		Datum 		SYN HMI 				Aenderungen
;	1.0.0		26.09.2025	H.-J. Albrecht		Programmerstellung  
;	1.0.1		14.07.2026	H.-J. Albrecht		SYN PLC in SYN HMI geändert
;
; Auslieferungsversion 1.0.0          
(---------------------------------------------------------------------------)
#VAR
   V.L.DistanceY = 10      ; Messdistanz
   V.L.ActPosY
#ENDVAR  
   
G90   
#HSC OFF
#MEAS [TYPE=1 EDGE=NEG INPUT=2]	; Umschaltung der Messsignalauswertung 

T9999 
D9999	; T- und D-Nummer 3D-Messtaster


#MSG SYN HMI ["Warte 3D-Messtaster eingeschaltet"]
M38	; 3D-Messtaster einschalten
G04 1
#FLUSH WAIT
#MSG SYN HMI [""]


V.L.ActPosY = V.A.ACT_POS.Y
G100 Y=V.L.ActPosY + V.L.DistanceY FV.E.FEEDMEASURE	
G01 Y=V.L.ActPosY FV.E.FEEDFAST		; Rückzug auf Startposition
	
$IF V.A.MERF.Y == TRUE
		#MSG SAVE EXCLUSIVE ["%S --- pos. Y-Messung, Messwert = %Fmm", V.G.TIME_STAMP_FILE_SYN HMI, V.A.MESS.Y]    
		#MSG SYN HMI ["pos. Y-Messung, Messwert = %Fmm", V.A.MESS.Y]
	$ELSE
		#MSG SAVE EXCLUSIVE ["%S --- pos. Y-Messung, kein Messwert", V.G.TIME_STAMP_FILE_SYN HMI]    
		#MSG SYN HMI ["pos. Y-Messung, kein Messwert"]
$ENDIF

#FLUSH WAIT
M39	; 3D-Messtaster ausschalten
M17
(-------------------- X-Nullpunkt B0 ermitteln ------------------)
