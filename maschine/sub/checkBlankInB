(----------------- PRÜFEN ob in B-Achse Blank vorhanden JA/NEIN -----------------)

(--Beschreibung-------------------------------------------------------------)
;  Mit diesem Programm wird eine vorgegebene Blankwechsler-Position ange-
;  fahren und überprüft, ob an dieser Position ein Blankhalter vorhanden ist  
;
;	Version		Datum 		Name 				Änderungen
;	1.0.0		27.11.2024	H.-J. Albrecht		Programmerstellung     
;	1.0.1		05.06.2024	H.-J. Albrecht		Ablauf und Variablen angepasst 
;	1.0.2		24.06.2024	H.-J. Albrecht		prüfen auf LEER, LEER mit Preformbasis, 
;												belegt mit Preformhalter, belegt mit Blankhalter 
;												unbekannter Messwert   
;	1.0.3		27.03.2026	H.-J. Albrecht		es werden jetzt die Messwerte auf den jeweiligen Positionen mitgeloggt
;	1.0.4		29.06.2026	H.-J. Albrecht		SYN PLC in SYN HMI geändert
;	1.1.0		03.09.2026	H.-J. Albrecht		C-Halter erkennen eingefügt
;												- hinzugefügt:
;														- V.L.ZLaserTakenValue 
;														- V.L.CHolderCheckDif
;														- V.L.CHolderYPosOffset
;														- V.L.CCheckYOffset
;												- Fehlermeldung werden jetzt mit V.E.MessageText definiert
;
(---------------------------------------------------------------------------)

#VAR
	V.L.BC_PosX = V.E.BlankPos[0].X + V.E.BC_CheckPosOffset.X		; X-Position die zum Prüfen angefahren werden soll
	V.L.BC_PosY = V.E.BlankPos[0].Y + V.E.BC_CheckPosOffset.Y		; Y-Position die zum Prüfen angefahren werden soll
	V.L.BC_PosZ = V.E.BlankPos[0].Z + V.E.BC_CheckPosOffset.Z		; Z-Position die zum Prüfen angefahren werden soll
	V.L.BC_PosA = -90
	V.L.BC_PosB = V.E.BPosTo.OpenSystem
	V.L.ZLaserMaxValue[4] = [V.E.BC_CheckPosZLaser0[0].MaxValue, V.E.BC_CheckPosZLaser0[1].MaxValue, V.E.BC_CheckPosZLaser0[2].MaxValue, V.E.BC_CheckPosZLaser0[3].MaxValue]
	V.L.ZLaserMinValue[4] = [V.E.BC_CheckPosZLaser0[0].MinValue, V.E.BC_CheckPosZLaser0[1].MinValue, V.E.BC_CheckPosZLaser0[2].MinValue, V.E.BC_CheckPosZLaser0[3].MinValue]
						; 0 = LEER, 1 = LEER mit Preformbasis , 2 = wird nicht verwendet, 3 = belegt mit Blankhalter
	V.L.ZLaserTakenValue
	V.L.CHolderCheckDif = V.P.CHolderCheckDif	; dieser Wert wird verwendet um feststellen zu können, ob ein C-Halter im Spannsystem ist.
												; Dieser Wert enspricht der Differenz die mindestens gemessen werden muss zwischen den beiden 
												; Positionen
	V.L.CHolderYPosOffset = V.P.CHolderYPosOffset	; Dieser Offset wird zur aktuellen Y-Position gerechnet um den zweiten Wert für den C-Halter 
													; zu ermitteln
	V.L.CCheckYOffset = 0   ; dieser Wert wird auf die Y-Position addiert, wenn ein C-Halter erwartet wird
	#ENDVAR

	
V.P.BlankPosChecked = 0

$IF V.P.BlankPosToCheck < 0
	V.E.MessageText = "checkBlankInB: Die definierte Wechslerposition=" + INT_TO_STR[V.P.BlankPosToCheck] + " ist ungültig"
	#MSG SAVE EXCLUSIVE ["%S --- %S", V.G.TIME_STAMP_FILE_NAME, V.E:MessageText]
	#MSG SYN HMI ["%S", V.E.MessageText]
	V.E.MessageNumber = 900	; Fehlermeldung in SPS erzeugen mit Text aus V.E.MessageText
	M199
$ENDIF

#HSC OFF
#MCS ON EX TOOL

G01 Z=V.A.+SWE.Z-1 FV.E.FEEDMAX	; Z hoch

G01 A=V.L.BC_PosA B=V.L.BC_PosB FV.E.FEEDMAX


$IF V.A.ACT_POS.X <= 0
		G01 X-50 FV.E.FEEDMAX
	$ELSEIF V.A.ACT_POS.X > 0
		G01 X50 FV.E.FEEDMAX
$ENDIF

$IF V.P.ExpectedBlankTyp == 6
      G01 Y=V.L.BC_PosY + V.L.CCheckYOffset FV.E.FEEDMAX
   $ELSE
      G01 Y=V.L.BC_PosY FV.E.FEEDMAX
$ENDIF
G01 X=V.L.BC_PosX FV.E.FEEDMAX	 	
G04 X0.5
#FLUSH WAIT
; Abfrage des Wertes
V.L.ZLaserTakenValue = V.E.SensorZLaser
$IF V.E.SensorZLaser >= V.L.ZLaserMinValue[3] AND V.E.SensorZLaser <= V.L.ZLaserMaxValue[3]	; belegt mit Blankhalter
		V.E.FunctionValue = 1	; belegt mit Blankhalter
		$IF V.P.ExpectedBlankTyp == 6
				G01 Y=V.L.BC_PosY + V.L.CHolderYPosOffset FV.E.FEEDMAX
				G04 X0.5
				#FLUSH WAIT
				$IF V.L.ZLaserTakenValue + V.L.CHolderCheckDif < V.E.SensorZLaser
						V.E.FunctionValue = 6	; belegt mit C-Halter
						#MSG SAVE EXCLUSIVE ["%S --- Im Spannsystem ist ein C-Halter. Messwert = %F (min %F/ max %F)", V.G.TIME_STAMP_FILE_NAME, V.E.SensorZLaser, V.L.ZLaserMinValue[3], V.L.ZLaserMaxValue[3]] 
					$ELSE
						#MSG SAVE EXCLUSIVE ["%S --- Im Spannsystem ist ein Blankhalter. Messwert = %F (min %F/ max %F)", V.G.TIME_STAMP_FILE_NAME, V.E.SensorZLaser, V.L.ZLaserMinValue[3], V.L.ZLaserMaxValue[3]] 
				$ENDIF
			$ELSE
				#MSG SAVE EXCLUSIVE ["%S --- Im Spannsystem ist ein Blankhalter. Messwert = %F (min %F/ max %F)", V.G.TIME_STAMP_FILE_NAME, V.E.SensorZLaser, V.L.ZLaserMinValue[3], V.L.ZLaserMaxValue[3]] 
		$ENDIF
		V.E.FunctionNumber = 3000 + V.P.BlankPosToCheck
	$ELSEIF V.E.SensorZLaser >= V.L.ZLaserMinValue[2] AND V.E.SensorZLaser <= V.L.ZLaserMaxValue[2]	; belegt mit Preformhalter
		V.E.FunctionNumber = 3000 + V.P.BlankPosToCheck
		V.E.FunctionValue = 2
		#MSG SAVE EXCLUSIVE ["%S --- Im Spannsystem ist ein Preformhalter. Messwert = %F (min %F/ max %F)", V.G.TIME_STAMP_FILE_NAME, V.E.SensorZLaser, V.L.ZLaserMinValue[2], V.L.ZLaserMaxValue[2]] 
	;$ELSEIF V.E.SensorZLaser >= V.L.ZLaserMinValue[1] AND V.E.SensorZLaser <= V.L.ZLaserMaxValue[1]	; LEER mit Preformbasis
	;	V.E.FunctionNumber = 3000 + V.P.BlankPosToCheck
	;	V.E.FunctionValue = 3
	$ELSEIF V.E.SensorZLaser >= V.L.ZLaserMinValue[0] AND V.E.SensorZLaser <= V.L.ZLaserMaxValue[0]	; LEER
		V.E.FunctionNumber = 3000 + V.P.BlankPosToCheck
		V.E.FunctionValue = 4
		#MSG SAVE EXCLUSIVE ["%S --- Das Spannsystem ist LEER. Messwert = %F (min %F/ max %F)", V.G.TIME_STAMP_FILE_NAME, V.E.SensorZLaser, V.L.ZLaserMinValue[0], V.L.ZLaserMaxValue[0]] 
	$ELSE						;undefinierter  Messwert
		V.E.FunctionNumber = 3000 + V.P.BlankPosToCheck
		V.E.FunctionValue = 5
		#MSG SAVE EXCLUSIVE ["%S --- Undefinierter Messwert bei Blankermittlung im Spannsystem. Messwert = %F", V.G.TIME_STAMP_FILE_NAME, V.E.SensorZLaser] 
$ENDIF

V.P.BlankPosChecked  = V.E.FunctionValue

G01 ZV.A.+SWE.Z-1 FV.E.FEEDMAX	;Z hoch

#MSG SYN HMI ["Warte auf SPS-Rueckmeldung"]
#WAIT FOR V.E.FunctionNumber == 0
#FLUSH WAIT
#MSG SYN HMI [""]

#MCS OFF
#HSC ON
[Label_Ende]
M17
(----------------- ENDE PRÜFEN ob in B-Achse Blank vorhanden JA/NEIN -----------------)