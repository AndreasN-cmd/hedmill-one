(--Beschreibung-------------------------------------------------------------)
;  Mit diesem Programm wird das aktuelle Werkzeugs in der Frässpindel 
;  in den Werkzeugwechsler abgelegt
;
;	Version		Datum 		Name 				Änderungen
;	1.0.0		28.11.2024	H.-J. Albrecht		Programmerstellung bis Auslieferung HM1.00000
;	1.1.0		15.05.2025	H.-J. Albrecht		Optimierung bis Auslieferung HM1.XXXXX
;	1.1.1		28.04.2026	H.-J. Albrecht		Z-PrePos eingefügt, damit soll verhindert werden, dass die Z-Haube auf den
;                                         Wechslerdeckel fahren kann
;	1.1.2		24.06.2026	H.-J. Albrecht		Z-PrePos wird jetzt auch beim Rausfahren verwendet
(---------------------------------------------------------------------------)

( ------ Unterprogramm Reaktion auf WZ-Halter runter gedrückt --------------)
%L UP_ZDriveUp	

#MSG SAVE EXCLUSIVE ["%S --- Werkzeughalter wurde runter gedrueckt", V.G.TIME_STAMP_FILE_NAME] 
#MSG SYN HMI ["Werkzeughalter wurde runter gedrueckt"]
G01 Z=V.A.+SWE.Z-1 FV.E.FEEDSLOW	;Z hoch
LSAFEPOS
#TOOL PREP [V.E.ToolInSpindle.Basic, V.E.ToolInSpindle.Sister, V.E.ToolInSpindle.Variant]
	$IF V.E.ToolInvalid == 0
		#TOOL DATA [V.E.ToolInSpindle.Basic, V.E.ToolInSpindle.Sister, V.E.ToolInSpindle.Variant]
		;DV.E.ToolInSpindle.Basic 
	$ENDIF

V.E.MessageNumber = 130 (Werkzeughalter wurde runter gedrückt)
M199

M17


( ---------------------------------------------------------------------- )
( ----------------- Hauptprogramm -------------------------------------- )
( ---------------------------------------------------------------------- )
%MAIN
#VAR
   V.L.TimeAfterOpenCone = 1
   V.L.ZPrePos = 80          ; auf diese Höhe wird die Z-Achse während der Positionierung in XY gefahren
#ENDVAR

V.E.ToolChangeActiveNo = 70


#MSG SYN HMI ["Warte auf Wechslerklappe geoeffnet"]
M61		; Wechslerklappe öffnen
#MSG SYN HMI [""]
#HSC OFF
#MCS ON EX TOOL
#MEAS [TYPE=1 SIGNAL=PLC EDGE=NEG]


G01 Z=V.A.+SWE.Z-1 FV.E.FEEDMAX	;Z hoch
;L checkToolExist
G01 X=V.P.TC_PosX Y=V.P.TC_PosY Z=V.L.ZPrePos FV.E.FEEDMAX

G01 Z=V.P.TC_PosZ+32 FV.E.FEEDMAX
;G01 Z=V.P.TC_PosZ+10 FV.E.FEEDMEASURE
;G01 Z=V.P.TC_PosZ FV.E.FEEDSLOW
G100 Z=V.P.TC_PosZ+15 FV.E.FEEDFAST		; Positionieren schnell, mit Überwachung ob WZ-Halter runtergedrückt wird
$IF V.A.MERF.Z == TRUE
	LL UP_ZDriveUp
	M0
$ENDIF
G100 Z=V.P.TC_PosZ+5 FV.E.FEEDMEASURE	; Positionieren mittel, mit Überwachung ob WZ-Halter runtergedrückt wird
$IF V.A.MERF.Z == TRUE
	LL UP_ZDriveUp
	M0
$ENDIF
G100 Z=V.P.TC_PosZ FV.E.FEEDSLOW		; Positionieren langsam, mit Überwachung ob WZ-Halter runtergedrückt wird
$IF V.A.MERF.Z == TRUE
	LL UP_ZDriveUp
	M0
$ENDIF

M70		;Konus auf

G04 V.L.TimeAfterOpenCone
#FLUSH WAIT

G01 Z=V.L.ZPrePos FV.E.FEEDMAX	;Z hoch
Y=V.E.TouchProbePos.Y-30 Z=V.A.+SWE.Z-1	 
X=V.E.TouchProbePos.X Y=V.E.TouchProbePos.Y Z=V.A.+SWE.Z-1	;auf XY-TouchProbePosition fahren 

L checkToolExist		;prüfen ob WZ wirklich aus Spindel
$IF V.P.ToolExist != 2	;WZ noch in Frässpindel
	#TOOL PREP [V.E.ToolInSpindle.Basic, V.E.ToolInSpindle.Sister, V.E.ToolInSpindle.Variant]
	;TV.E.ToolInSpindle.Basic 
	$IF V.E.ToolInvalid == 0
		#TOOL DATA [V.E.ToolInSpindle.Basic, V.E.ToolInSpindle.Sister, V.E.ToolInSpindle.Variant]
		;DV.E.ToolInSpindle.Basic 
	$ENDIF
	M71	;Konus zu
	L SAFEPOS
	#MSG SAVE EXCLUSIVE ["%S --- T%D wurde nicht erfolgreich in den Werkzeugwechsler abgelegt", V.G.TIME_STAMP_FILE_NAME, V.E.ToolInSpindle.Basic] 
	#MSG SYN HMI ["T%D wurde nicht erfolgreich in den Werkzeugwechsler abgelegt", V.E.ToolInSpindle.Basic]
	V.E.MessageNumber = 120 (WZ blieb in der Spindel)
	M199
$ENDIF
#MSG SAVE EXCLUSIVE ["%S --- T%D wurde erfolgreich in den Werkzeugwechsler abgelegt", V.G.TIME_STAMP_FILE_NAME, V.E.ToolInSpindle.Basic] 

#MEAS DEFAULT	; Wiederherstellen der Messeinstellungen aus den Achsparametern für alle Bahnachsen

#FLUSH WAIT
V.E.ToolChangeActiveNo = 80

M17
(----------------- ENDE WZ ABLEGEN -----------------)