(-------------------- Blankhalter aus Wechsler holen -----------------------)

(--Beschreibung-------------------------------------------------------------)
;  Mit diesem Programm wird ein Blankhalter aus dem Wechsler geholt
;
;	Version		Datum 		Name 				aenderungen
;	1.0.0		28.11.2024	H.-J. Albrecht		Programmerstellung
;	1.0.1		05.06.2025	H.-J. Albrecht		M83 am Anfang eingefuegt
;												M85=1 fuer pruefen auf gegeriffen
;	1.0.2		18.06.2025	H.-J. Albrecht		Rundwechslerablauf mit eingebunden
;	1.0.3		03.03.2026	H.-J. Albrecht		Anpasssungen fuer das Holen von Preformhalter aus RC
;	1.0.4		19.03.2026	H.-J. Albrecht		Jetzt werden die Offsetwerte aus setVPVars fuer die 
;												Positionierung der Blankpositionen verrechnet
;	1.0.5		19.03.2026	H.-J. Albrecht		SYN PLC in SYN HMI geaendert
;												bei Pos 7 5mm nach links um nicht die Lamellen vom Faltenbalg zu zerstoeren
;	1.1.0		24.06.2026	H.-J. Albrecht		Ablauf wegen den Scharnieren am Wechslerdeckel geaendert
;	1.2.0		04.09.2026	H.-J. Albrecht		C-Halter ablegen eingefuegt
;												pruefen ob der Blank im Wechsler ist hinzugefuegt
;												UP_RCPosArrived hinzugefuegt
;												UP_CheckBeforeStart
;												UP_LiftIsOnTop
;
; 
(---------------------------------------------------------------------------)

( ------ Unterprogramm SAFEPOS und Wechslerklappe schließen ---------)
%L UP_SafeAndWait
	#MSG SYN HMI ["Warte auf Blankhubzylinder Rundwechsler unten"]
	M93 ; Blankhubzylinder Rundwechsler SENKEN
	L SAFEPOS
	#MSG SYN HMI ["Warte auf Wechslerklappe geschlossen"]
	M62	; Wechslerklappe schließen
	#MSG SYN HMI [""]
	M50   ; Loadertuer entriegeln
M17


( ------ Unterprogramm Drehwechsler positionieren ---------)
%L UP_StartPosRC
	M93   ; pruefen ob Hubzylinder unten
	#FLUSH WAIT
	V.E.FunctionNumber = 3500	; Starte Rundwechsler auf Position aus FunctionValue
	V.E.FunctionValue = V.E.BlankRequest.Pos
	#MSG SYN HMI ["Positionierung Rundwechsler wurde gestartet"]
	;M90=1	; Rundwechsler Positionierung starten, mit Positionsermittlung durch INI
	M90	; Rundwechsler Positionierung starten
	#FLUSH WAIT
M17


( ------ Unterprogramm Wechsler-Kassette und Loadertuer pruefen ---------)
%L UP_CheckBeforeStart

$IF V.E.HWInput.ToolCassetteAvailable == FALSE
	#MSG SYN HMI ["Wechsler-Kassette bitte richtig rein schieben"]
$ENDIF
#WAIT FOR V.E.HWInput.ToolCassetteAvailable == TRUE
#FLUSH WAIT
;M112	; Reinigungsluft Kassette EIN
;G04 2
;M111 	; Reinigungsluft Kassette AUS
#MSG SYN HMI ["Loadertuer bitte schlieÃŸen"]
M51   	; Loadertuer verriegeln
#MSG SYN HMI [""]

M17


( ---------------- Unterprogramm zum ueberpruefen ob der Drehwechsler ---------------- )
( ---------------- seine Position erreicht hat ------------------------------------- )
%L UP_RCPosArrived
	M91 ; warten das Rundwechsler Position erreicht hat
	#MSG SYN HMI ["Warte auf Rundwechsler Position erreicht"]
	#FLUSH WAIT
	$IF V.E.FeedbackMFunc == -91 
		;;; ???     Position wurde nicht erreicht
		M199
	$ENDIF
M17


( ---------------- Unterprogramm zum ueberpruefen ob der Hubzylinder  ---------------- )
( ---------------- oben angekommen ist. -------------------------------------------- )
%L UP_LiftIsOnTop
	M92 ; Blankhubzylinder Rundwechsler HEBEN
	#FLUSH WAIT
	$IF V.E.FeedbackMFunc == -92 
		;;; ???     Heben nicht erfolgreich
		M199
	$ENDIF
M17

( ---------------------------------------------------------------------- )
( ----------------- Hauptprogramm -------------------------------------- )
( ---------------------------------------------------------------------- )
%MAIN

#VAR
	V.L.PosZPrePickOffset = 20		
	V.L.PosZPickOffset = -4
	V.L.PickPosX = -5000.0 					; errechnete X-Position fuer das Holen eines Blanks
	V.L.PickPosY = -5000.0 					; errechnete Y-Position fuer das Holen eines Blanks
	V.L.PickPosZ = -5000.0 					; errechnete Z-Position fuer das Holen eines Blanks
	V.L.PickPos5X = -5000.0 					; errechnete X-Position Pos 5 fuer das Holen eines Preforms
	V.L.PickPos5Y = -5000.0 					; errechnete Y-Position Pos 5 fuer das Holen eines Preforms
	V.L.PickPos5Z = -5000.0 					; errechnete Z-Position Pos 5 fuer das Holen eines Preforms
	V.L.PickPos6Z = -5000.0 					; errechnete Z-Position Pos 6 fuer das Holen eines Preforms
	; -5000, damit die CNC in Stoerung geht, da der Softwareendschalter ueberfahren wird
	V.L.SafeOffsetXPos7 = -5             ; Korrekturwert um nach dem Anheben des Blankgreifers nicht zu nah an den Faltenbalglamellen zu sein
	V.L.tempBlankPosToCheck = -1		 ; wird benoetigt um die Drehwechslerposition zwischenzuspeichern
#ENDVAR
[Label_Start]

V.E.BlankChangeActiveNo = 10		; 10= Blankhalter aus Wechsler holen gestartet

#HSC OFF
#MCS ON EX TOOL

$IF V.E.BlankRequest.Pos > 100 AND V.E.BlankRequest.Pos < 131
	LL UP_StartPosRC
$ENDIF

#MSG SYN HMI ["Warte auf Wechslerklappe geoeffnet"]
M61		; Wechslerklappe oeffnen
#FLUSH WAIT

#MSG SYN HMI ["Warte auf Blankgreifer-Hubzylinder oben"]
M83		; Blankgreifer-Hubzylinder heben
#FLUSH WAIT


L ToolWeightOff	; Werkzeugstandzeitgewichtung deaktivieren

G01 Z= V.A.+SWE.Z-1 FV.E.FEEDMAX M84	; Z hoch ; Blankgreifer oeffnen
#MSG SYN HMI ["Warte auf Blankgreifer geoeffnet"]

$IF V.A.ACT_POS.Y > -85.0
	$IF V.A.ACT_POS.X <= 0
			G01 X-25
		$ELSEIF V.A.ACT_POS.X > 0
			G01 X25
	$ENDIF
	G01 Y-85
$ENDIF


$IF V.E.BlankRequest.Pos > 0 AND V.E.BlankRequest.Pos < 8
		V.L.PickPosX = V.E.BlankPos[V.E.BlankRequest.Pos].X + V.P.PickBlankOffset[0]
		V.L.PickPosY = V.E.BlankPos[V.E.BlankRequest.Pos].Y + V.P.PickBlankOffset[1]
		V.L.PickPosZ = V.E.BlankPos[V.E.BlankRequest.Pos].Z + V.P.PickBlankOffset[2]	
		G01 X= V.L.PickPosX Y= V.L.PickPosY
	$ELSEIF V.E.BlankRequest.Pos > 100 AND V.E.BlankRequest.Pos < 131		
		V.L.PickPos5X = V.E.BlankPos[5].X + V.P.PickBlankOffset[0]
		V.L.PickPos5Y = V.E.BlankPos[5].Y + V.P.PickBlankOffset[1]
		V.L.PickPos5Z = V.E.BlankPos[5].Z + V.P.PickBlankOffset[2]
			;G01 X= V.E.BlankPos[5].X Y= V.E.BlankPos[5].Y 
		G01 X= V.L.PickPos5X Y= V.L.PickPos5Y
	$ELSE
		#MSG SYN HMI ["Es wurde eine nicht definierte Blankposition angefragt %D", V.E.BlankRequest.Pos]
		M62	; Wechslerklappe schließen
		M199
$ENDIF
#FLUSH WAIT

[Label_CheckBlankTyp6]
; wenn ein C-Halter aus dem Drehwechsler geholt werden soll, Drehwechslerposition abwarten
; Hubzylinder anheben und dann mit checkBlankAtPos pruefen, ob ein C-Halter vorhanden ist
$IF V.P.ExpectedBlankTyp == 6 AND V.E.BlankRequest.Pos > 100 AND V.E.BlankRequest.Pos < 131
	V.L.tempBlankPosToCheck = V.E.BlankRequest.Pos
	V.P.BlankPosToCheck = 5
	LL UP_RCPosArrived
	$IF V.E.HWInput.PreformHolderOnPlace == True
	   $GOTO [Label_NoCHolder]
	$ENDIF
	LL UP_LiftIsOnTop
	L checkBlankAtPos
	#FLUSH WAIT
	#HSC OFF
   #MCS ON EX TOOL
	$IF V.P.BlankPosChecked != V.P.ExpectedBlankTyp
	   [Label_NoCHolder]
		LL UP_SafeAndWait
		V.E.MessageText = "Auf der Position " + INT_TO_STR[V.L.tempBlankPosToCheck-100] + " im Rundwechsler ist kein C-Halter"
		#MSG SAVE EXCLUSIVE ["%S --- %S", V.G.TIME_STAMP_FILE_NAME, V.E.MessageText]
		#MSG SYN HMI ["%S", V.E.MessageText]
		V.E.MessageNumber = 900	; Fehlermeldung in SPS erzeugen mit Text aus V.E.MessageText
		M0
		#FLUSH WAIT
		V.E.MessageNumber = 0
		#MSG SYN HMI [""]
		LL UP_CheckBeforeStart
		LL UP_StartPosRC
		$GOTO [Label_CheckBlankTyp6]
	$ENDIF
	G01 X= V.L.PickPos5X Y= V.L.PickPos5Y FV.E.FEEDSLOW
$ENDIF



;M86 = 1500	; Reinigungsluft Greifer verzoegert einschalten
[Label_Pick]
$IF V.E.BlankRequest.Pos > 0 AND V.E.BlankRequest.Pos < 8
      #MSG SYN HMI ["Warte auf Blankgreifer-Hubzylinder gesenkt"]
      M82		; Blankgreifer-Hubzylinder senken
      #FLUSH WAIT
      $IF V.P.BlankPosChecked == 2  ; Preformhalter soll geholt werden
      		G01 Z= V.L.PickPosZ + V.L.PosZPrePickOffset
      		G01 Z= V.L.PickPosZ + V.P.ZOffsetPreformC + V.P.ZOffsetGetPreform FV.E.FEEDMEASURE
   			M85   ; Greifer schliessen, pruefen auf nicht mehr offen
   			G01 Z= V.L.PickPosZ + V.P.ZOffsetPreformC    ; auf Holen-Position fahren
		   $ELSE    ; Blankhalter soll geholt werden
      		G01 Z= V.L.PickPosZ + V.L.PosZPrePickOffset
      		G01 Z= V.L.PickPosZ + V.L.PosZPickOffset FV.E.FEEDMEASURE
	   $ENDIF
	$ELSEIF V.E.BlankRequest.Pos > 100 AND V.E.BlankRequest.Pos < 131	
		$IF V.P.ExpectedBlankTyp != 6
			LL UP_RCPosArrived
			LL UP_LiftIsOnTop
		$ENDIF
		
		$IF V.P.BlankPosChecked == 3  ; Preformhalter soll geholt werden
   		   V.L.tempBlankPosToCheck = V.E.BlankRequest.Pos
   	      V.P.BlankPosToCheck = 5
   	      V.P.ExpectedBlankTyp = 2
   	      L checkBlankAtPos
   	      #FLUSH WAIT
   	      #HSC OFF
            #MCS ON EX TOOL
   	      $IF V.P.BlankPosChecked != V.P.ExpectedBlankTyp
            		LL UP_SafeAndWait
            		V.E.MessageText = "Auf der Position " + INT_TO_STR[V.L.tempBlankPosToCheck-100] + " im Rundwechsler ist kein PreformHalter"
            		#MSG SAVE EXCLUSIVE ["%S --- %S", V.G.TIME_STAMP_FILE_NAME, V.E.MessageText]
            		#MSG SYN HMI ["%S", V.E.MessageText]
            		V.E.MessageNumber = 900	; Fehlermeldung in SPS erzeugen mit Text aus V.E.MessageText
            		M199=1
            		M0
            		#FLUSH WAIT
            		V.E.MessageNumber = 0
            		#MSG SYN HMI [""]
            		LL UP_CheckBeforeStart
            		LL UP_StartPosRC
                  $GOTO [Label_Start]    
   	         $ELSE
   	            G01 X= V.L.PickPos5X Y= V.L.PickPos5Y FV.E.FEEDSLOW
		            G01 Z= V.L.PickPos5Z + V.L.PosZPrePickOffset
                  #MSG SYN HMI ["Warte auf Blankgreifer-Hubzylinder gesenkt"]
                  M82		; Blankgreifer-Hubzylinder senken
                  #FLUSH WAIT
      			; Z-Wert von Position 6, da die Greifhoehen der Preforms im Wechsler und aus dem RC-Lift gleich hoch sind
      			; Die Z-Werte fuer Blankhalter sind unterschiedlich, dann wuerde fuer Pos ein weiterer OffsetWert fuer das holen
      			; eines Preformhalter benoetigt werden 
      				V.L.PickPos6Z = V.E.BlankPos[6].Z + V.P.PickBlankOffset[2]
      				G01 Z= V.L.PickPos6Z + V.L.PosZPrePickOffset
      				G01 Z= V.L.PickPos6Z + V.P.ZOffsetPreformC + V.P.ZOffsetGetPreform FV.E.FEEDMEASURE
      				M85   ; Greifer schliessen, pruefen auf nicht mehr offen
      				G01 Z= V.L.PickPos6Z + V.P.ZOffsetPreformC    ; auf Holen-Position fahren
      		$ENDIF
			$ELSE    ; Blankhalter oder C-Halter soll geholt werden
   	      #HSC OFF
            #MCS ON EX TOOL
            #MSG SYN HMI ["Warte auf Blankgreifer-Hubzylinder gesenkt"]
            M82		; Blankgreifer-Hubzylinder senken
            #FLUSH WAIT
   		   G01 Z= V.L.PickPos5Z + V.L.PosZPrePickOffset
				G01 Z= V.L.PickPos5Z FV.E.FEEDMEASURE
					;G01 Z= V.E.BlankPos[5].Z FV.E.FEEDMEASURE
		$ENDIF
$ENDIF

#MSG SYN HMI ["Warte auf Blankgreifer gegriffen"]
M85	; Blankgreifer schließen, auf nicht offen pruefen
#MSG SYN HMI [""]
#FLUSH WAIT

M87 = 250	; Reinigungsluft Greifer verzoegert ausschalten

#HSC OFF
#MCS ON EX TOOL
G01 Z= V.A.+SWE.Z-1 FV.E.FEEDSLOW 		; Z hoch, Blankgreifer-Hubzylinder heben
#FLUSH WAIT

M85=1	; Blankgreifer schließen, auf gegriffen pruefen

$IF V.E.BlankRequest.Pos > 0 AND V.E.BlankRequest.Pos < 8
		G01 Y= V.L.PickPosY  + 3 FV.E.FEEDMEASURE
	$ELSEIF V.E.BlankRequest.Pos > 100 AND V.E.BlankRequest.Pos < 131			
		G01 Y= V.L.PickPos5Y + 3 FV.E.FEEDMEASURE
$ENDIF

$IF V.E.BlankRequest.Pos > 100 AND V.E.BlankRequest.Pos < 131
	M93=-100 ; Blankhubzylinder Rundwechsler SENKEN, -100 --> direkte Quittierung von M93
$ENDIF
		
#MSG SYN HMI ["Warte auf Blankgreifer-Hubzylinder oben"]
M83		; Blankgreifer-Hubzylinder heben
#MSG SYN HMI [""]
#FLUSH WAIT


$IF V.E.BlankRequest.Pos == 7	; bei Pos 7 5mm nach links um nicht die Lamellen vom Faltenbalg zu zerstoeren
	G01 X= V.L.PickPosX + V.L.SafeOffsetXPos7 FV.E.FEEDMEASURE
$ENDIF	


V.E.BlankInGripper.Pos = V.E.BlankRequest.Pos
V.E.BlankInGripper.Name = V.E.BlankRequest.Name
V.E.BlankRequest.Pos = 0
V.E.BlankRequest.Name = ""

#MSG SAVE EXCLUSIVE ["%S --- Blank '%S' aus Wechslerposition %D geholt", V.G.TIME_STAMP_FILE_NAME, V.E.BlankInGripper.Name, V.E.BlankInGripper.Pos]    

V.E.BlankChangeActiveNo = 20		; 20= Blankhalter aus Wechsler holen beendet

#MCS OFF
#HSC ON

M17
(----------------- ENDE WZ PRueFEN -----------------)