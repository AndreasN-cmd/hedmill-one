(-------------------- Blankhalter in B-Achse absetzen ----------------------)

(--Beschreibung-------------------------------------------------------------)
;  Mit diesem Programm wird ein Blankhalter in dem Nullpunktspannsystem
;  in der B-Achse abgesetzt            
;
;	Version		Datum 		Name 				aenderungen
;	1.0.0		28.11.2024	H.-J. Albrecht		Programmerstellung
;	1.0.1		06.06.2025	H.-J. Albrecht		M85=2 zur Pruefung, ob Blankhalter
;												wirklich abgelget wurde
;	1.0.2		03.03.2026	H.-J. Albrecht		Anpassung Ablegen PreformHalter in B geholt aus RC
;	1.0.3		16.03.2026	H.-J. Albrecht		Reinigung der Npkt-Spannflaeche vor dem Einsetzen
;												des Halters
;	1.0.4		19.03.2026	H.-J. Albrecht		Nach bem oeffnen-Befehl des Blankgreifers, faehrt die Maschine 
;												  jetzt 2mm nach oben um ein moegliches Verklemmen zu loesen
;	1.0.5		29.06.2026	H.-J. Albrecht		SYN PLC in SYN HMI geaendert
;	1.1.0		04.09.2026	H.-J. Albrecht		C-Halter ablegen eingefuegt
;
(---------------------------------------------------------------------------)

#VAR
	V.L.PosZPlaceOffset = -5
	
#ENDVAR

V.E.BlankChangeActiveNo = 30		; 30= Blankhalter in B-Achse absetzen gestartet

#HSC OFF
#MCS ON EX TOOL

L ToolWeightOff	; Werkzeugstandzeitgewichtung deaktivieren

G01 Z= V.A.+SWE.Z-1 FV.E.FEEDSLOW	; Z hoch
G01 A-90 B= V.E.BPosTo.OpenSystem FV.E.FEEDFAST
G01 X= V.E.BlankPos[0].X Y= V.E.BlankPos[0].Y FV.E.FEEDSLOW

(-----------------------------------------------------------------------------------------)
M62	; Wechslerklappe schliessen
#MSG SYN HMI [""]
M50   ; Loadertuer entriegeln
(-----------------------------------------------------------------------------------------)


M80		; Blankklemmung oeffnen
#MSG SYN HMI ["Warte auf Blankgreifer-Hubzylinder gesenkt"]

;G01 Z= V.E.BlankPos[0].Z + V.L.PosZPreOffset
$IF V.P.BlankPosChecked == 2 OR V.P.BlankPosChecked == 3  ; Preformhalter soll abgesetzt werden
      
      M82		; Blankgreifer-Hubzylinder senken
      #MSG SYN HMI [""]
      G01 Z= V.E.BlankPos[0].Z + V.P.ZOffsetPreformM + 30 FV.E.FEEDMEASURE 
      M81		; Blankklemmung schlieﬂen
      
      M132  ; B-Achse Reinigungsluft ein
      G91
      G01 B2700 F30000 
      B-2700
      
      G90
      M131  ; B-Achse Reinigungsluft aus
      M80		; Blankklemmung oeffnen
      G01 Z= V.E.BlankPos[0].Z + V.P.ZOffsetPreformM FV.E.FEEDMEASURE  
   
   $ELSE    ; Blankhalter soll abgesetzt werden
      M81		; Blankklemmung schlieﬂen
      
      M132  ; B-Achse Reinigungsluft ein
      G91
      G01 B2700 F30000 
      B-2700
      
      G90
      M131  ; B-Achse Reinigungsluft aus
      M80		; Blankklemmung oeffnen
      M82		; Blankgreifer-Hubzylinder senken
      #MSG SYN HMI [""]
      G01 Z= V.E.BlankPos[0].Z + V.L.PosZPlaceOffset FV.E.FEEDMEASURE
$ENDIF

M81		; Blankklemmung schlieﬂen

#MSG SYN HMI ["Warte auf Blankgreifer geoeffnet"]
M84=100		; Blankgreifer oeffnen, =100 Quittierung auch bei Misserfolg
G01 G91 Z2 F500
M84			; Blankgreifer oeffnen
G90
#FLUSH WAIT

#MSG SYN HMI ["Warte auf Blankgreifer-Hubzylinder oben"]
G01 Z= V.A.+SWE.Z-1 FV.E.FEEDMAX M83		; Z hoch, Blankgreifer-Hubzylinder heben
#FLUSH WAIT

#MSG SYN HMI ["Warte auf Blankgreifer geschlossen"]
M85=2		; Blankgreifer schliessen, pruefen ob leer
#MSG SYN HMI [""]
#FLUSH WAIT


G01 B= V.E.BPosTo.BoostSystem

M88		; Booster Blankklemmung aktivieren

V.E.BlankInMachine.Pos = V.E.BlankInGripper.Pos
V.E.BlankInMachine.Name = V.E.BlankInGripper.Name
V.E.BlankInGripper.Pos = 0
V.E.BlankInGripper.Name = ""

#MSG SAVE EXCLUSIVE ["%S --- Blank '%S' im B-Achsennullpunktspannsystem abgesetzt", V.G.TIME_STAMP_FILE_NAME, V.E.BlankInMachine.Name]    
  


V.E.BlankChangeActiveNo = 40		; 40= Blankhalter in B-Achse absetzen beendet

#MCS OFF
#HSC ON

M17
(----------------- Blankhalter in B-Achse absetzen ENDE ----------------------)