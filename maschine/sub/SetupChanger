[Label_MainCrash]
	#MSG SAVE EXCLUSIVE ["%S --- Während der Positionierung wurde der 3D-Messtaster ausgelöst", V.G.TIME_STAMP_FILE_NAME]
	#MSG SYN HMI ["Während der Positionierung wurde der 3D-Messtaster ausgelöst"]
	V.E.MessageNumber = 420	; CRASH mit 3D-Taster
	M199
; ----------------------------------------------------------------------------------------------------------
	
[Label_Ende]


#FLUSH WAIT
V.E.FunctionNumber = 0
V.E.FunctionValue = 0
#FLUSH WAIT

#MCS ON EX TOOL
G01 Z=V.A.+SWE.Z-1 FV.E.FEEDSLOW
#MCS OFF

#MEAS MODE [5]
$IF ABS[V.A.ACT_POS.X] > 1
	G310 G01 X0 FV.E.FEEDSLOW $GOTO [Label_MainCrash]
$ENDIF
$IF ABS[V.A.ACT_POS.Y] > 1
	G310 G01 Y0 FV.E.FEEDSLOW $GOTO [Label_MainCrash]
$ENDIF

#FLUSH WAIT

#MSG SYN HMI ["Warte auf Wechslerklappe geschlossen"]
M62	; Wechslerklappe schließen
M50   ; Loadertuer entriegeln
#MSG SYN HMI ["Warte 3D-Messtaster ausgeschaltet"]
M39	; 3D-Messtaster ausschalten
#MSG SYN HMI [""]

#MEAS DEFAULT
;#MCS OFF
#HSC ON

#MSG SAVE EXCLUSIVE ["%S --- !! WICHTIG !! Messpins aus dem Wechsler entfernen !!!", V.G.TIME_STAMP_FILE_NAME]
#MSG SYN HMI ["!! WICHTIG !! Messpins aus dem Wechsler entfernen !!!"]
M17
(---------------------- Wechslerkassette ausmessen ENDE -------------------)

