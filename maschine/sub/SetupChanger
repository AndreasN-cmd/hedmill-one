( ----------------- Hauptprogramm -------------------------------------- )
( ---------------------------------------------------------------------- )
%MAIN
#VAR
   V.L.CalcBlanlkPos = FALSE                       ; TRUE = auch die Blankpositionen werden berechnet
	;Messzapfen	
	V.L.PosReference1[3] = [-132.0, -219.8, 10]		; Position des ersten Messzapfen [0]=X, [1]=Y, [2]=Z
	V.L.PosReference2[3] = [V.L.PosReference1[0] + 176, V.L.PosReference1[1], V.L.PosReference1[2]]		   ; Position des zweiten Messzapfen [0]=X, [1]=Y, [2]=Z
	V.L.BasisDiameter =	8.0							   ; Durchmesser eines Messzapfens
	
	;Werkzeuge
	V.L.ReferenceDistanceTX = 8		; Mittelpunktsabstand in X-Richtung von Messzapfen1 zum WZ-Platz1
	V.L.ReferenceDistanceTY = 8.5	; Mittelpunktsabstand in Y-Richtung von Messzapfen1 zum WZ-Platz1
	V.L.IntervalTX = 16				; Rastermass in X-Richtung der WZ-Plätze
	V.L.StartPlaceRow[2] = [1, 15]	; definiert den ersten WZ-Platz in einer Reihe, [0]= Reihe 1, [1]= Reihe 2 
	V.L.ToolsInRow = V.L.StartPlaceRow[1] - V.L.StartPlaceRow[0] 	; definiert die Anzahl an WZ-Plätzen in einer Reihe
	
	;Blanks	
	V.L.ReferenceDistanceBX = 1.6;10	; Mittelpunktsabstand in X-Richtung vom WZ-Platz1 zum Blank-Platz1
	V.L.ReferenceDistanceBY = 11 ;8.5	; Mittelpunktsabstand in Y-Richtung vom WZ-Platz1 zum Blank-Platz1
	V.L.IntervalBX = 35				; Rastermass in X-Richtung der Blank-Plätze
	V.L.BlanksInRow = 7				; definiert die Anzahl an Blank-Plätzen in einer Reihe
	
	; Unterprogramm
	V.L.No
	V.L.XYZPos[3]
	V.L.tmpMPZ
	V.L.tmpMPs[3][2]
	V.L.XYOffset = 8
	V.L.tmpPos
	V.L.CalculatedCenter[2]
	
	; Berechnung 01
	V.L.Center[2][3]				; Mittelpunkte der Messzapfen, [Messzapfen] [X/Y/Z]
	V.L.DifPosReference[3]			; Differenzwerte der ermittelten XYZ-Mittelpunkte der beiden Messzapfen [0]=difX, [1]=difY, [2]=difZ
	V.L.AngleXY
	V.L.AngleXZ
	
	; Berechnung 02
	V.L.DistanceVector				; Abstand (direkter Vektor) zwischen Messzapfen1 und WZ-Platz1 
	V.L.AngleToTP1					; enstandener Winkel zwischen Messzapfen1 und WZ-Platz1
	V.L.DeltaXYTP1[2]				; Offset Ursprung WZ-Platz1 zum aktuellen WZ-Platz1 [0]=X, [1]=Y
	
	; Berechnung 03
	V.L.ShiftVectorRow[2]			; Verschiebungsvektor fuer WZ-Plätze 2-14 auf Basis von WZ-Platz1, [0]=X, [1]=Y
	
	; Berechnung 06
	V.L.DistanceVectorB				; Abstand (direkter Vektor) zwischen WZ-Platz1 und Blank-Platz1
	V.L.AngleToBP1					; enstandener Winkel zwischen WZ-Platz1 und Blank-Platz1
	V.L.DeltaXYBP1[2]				; Offset Ursprung Blank-Platz1 zum aktuellen Blank-Platz1 [0]=X, [1]=Y
	
	; Berechnung 07
	V.L.ShiftVectorRowB[2]			; Verschiebungsvektor fuer WZ-Plätze 2-14 auf Basis von WZ-Platz1, [0]=X, [1]=Y
#ENDVAR

L DYN-Standard

T9999 ; T- und D-Nummer 3D-Messtaster
#FLUSH WAIT
;L measureTool

#HSC OFF
;#MCS ON EX TOOL
#MEAS [TYPE=1 EDGE=NEG INPUT=2]	; Umschaltung der Messsignalauswertung 
; Mittelpunkt- und Hoehenbestimmung Messzapfen1


L ToolWeightOff	; Werkzeugstandzeitgewichtung deaktivieren

M5    	; Frässpindel aus
M9    	; Kuehlmittelpumpe aus

$IF NOT[V.E.HWInput.ToolCassetteAvailable]
	#MSG SYN HMI ["Wechsler-Kassette bitte richtig rein schieben"]
$ENDIF

#WAIT FOR V.E.HWInput.ToolCassetteAvailable		; Werkzeug/Blank-Kassette eingeschoben ?

M112	; Reinigungsluft Kassette EIN
G04 1
M111 	; Reinigungsluft Kassette AUS
#MSG SYN HMI ["Loadertuer bitte schließen"]
M51   	; Loadertuer verriegeln
#MSG SYN HMI [""]



#MSG SYN HMI ["Warte 3D-Messtaster eingeschaltet"]
M38	; 3D-Messtaster einschalten
G04 1
#FLUSH WAIT

D9999	; T- und D-Nummer 3D-Messtaster


$IF V.E.MeasureSignal[1] != 1	; pruefen ob der Messtaster ein 1-Signal liefert, 0 --> Störung
    V.E.MessageNumber = 208 (3D-Messtaster liefert vor der Messung 0-Wert)
	#MSG SYN HMI ["Messung kann nicht gestartet werden, 3D-Messtaster nicht bereit"]
    M199
$ENDIF

#MCS ON EX TOOL
G01 Z=V.A.+SWE.Z-1 FV.E.FEEDSLOW
#MCS OFF

#MEAS MODE [5]
$IF ABS[V.A.ACT_POS.X] > 1
	G310 G01 X0 FV.E.FEEDSLOW $GOTO [Label_MainCrash]
$ENDIF
$IF ABS[V.A.ACT_POS.Y] > 1
	G310 G01 Y0 FV.E.FEEDSLOW $GOTO [Label_MainCrash]
$ENDIF

#MSG SYN HMI ["Warte auf Wechslerklappe geöffnet"]
M61		; Wechslerklappe öffnen
#MSG SYN HMI [""]

V.L.XYZPos[0] = V.L.PosReference1[0]
V.L.XYZPos[1] = V.L.PosReference1[1]
V.L.XYZPos[2] = V.L.PosReference1[2]
LL UP_FindCenterPoint
LL UP_CalcCenterPoint
V.L.Center[0][0] = V.L.CalculatedCenter[0]
V.L.Center[0][1] = V.L.CalculatedCenter[1]
#MSG SAVE EXCLUSIVE ["%S --- Berechnung Center1, X = %Fmm, Y = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.Center[0][0], V.L.Center[0][1]] 

; Mittelpunkt- und Hoehenbestimmung Messzapfen2
V.L.XYZPos[0] = V.L.PosReference2[0]
V.L.XYZPos[1] = V.L.PosReference2[1]
V.L.XYZPos[2] = V.L.PosReference2[2]
LL UP_FindCenterPoint
LL UP_CalcCenterPoint
V.L.Center[1][0] = V.L.CalculatedCenter[0]
V.L.Center[1][1] = V.L.CalculatedCenter[1]
#MSG SAVE EXCLUSIVE ["%S --- Berechnung Center2, X = %Fmm, Y = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.Center[1][0], V.L.Center[1][1]] 

#FLUSH WAIT
V.E.FunctionNumber = 3300
V.E.FunctionValue = 1
#FLUSH WAIT

; Berechnung 01, Schiefstellung zwischen den Messzapfen
V.L.DifPosReference[0] = V.L.Center[0][0] - V.L.Center[1][0]
V.L.DifPosReference[1] = V.L.Center[0][1] - V.L.Center[1][1]
V.L.DifPosReference[2] = V.L.Center[0][2] - V.L.Center[1][2]
#MSG SAVE EXCLUSIVE ["%S --- Berechnung 01, difX = %Fmm, difY = %Fmm, difZ = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.DifPosReference[0], V.L.DifPosReference[1], V.L.DifPosReference[2]]  
V.L.AngleXY = ATAN[V.L.DifPosReference[1]/V.L.DifPosReference[0]]
V.L.AngleXZ = ATAN[V.L.DifPosReference[2]/V.L.DifPosReference[0]]
#MSG SAVE EXCLUSIVE ["%S --- Berechnung 01, XY = %F°, XZ = %F°", V.G.TIME_STAMP_FILE_NAME, V.L.AngleXY, V.L.AngleXZ]  

; Berechnung 02, WZ-Platz1, Basis fuer alle anderen WZ-Plätze
V.L.DistanceVector = SQRT[SQR[V.L.ReferenceDistanceTX] + SQR[V.L.ReferenceDistanceTY]]
V.L.AngleToTP1 = ATAN[V.L.ReferenceDistanceTY/V.L.ReferenceDistanceTX] + V.L.AngleXY
#MSG SAVE EXCLUSIVE ["%S --- Berechnung 02, Vector = %Fmm, Winkel = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.DistanceVector, V.L.AngleToTP1]  
V.L.DeltaXYTP1[0] = COS[V.L.AngleToTP1]*V.L.DistanceVector
V.L.DeltaXYTP1[1] = SIN[V.L.AngleToTP1]*V.L.DistanceVector
#MSG SAVE EXCLUSIVE ["%S --- Berechnung 02, deltaX = %Fmm, deltaY = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.DeltaXYTP1[0], V.L.DeltaXYTP1[1]] 
V.E.ToolPos[1].X = V.L.Center[0][0] - V.L.DeltaXYTP1[0]
V.E.ToolPos[1].Y = V.L.Center[0][1] + V.L.DeltaXYTP1[1]
#MSG SAVE EXCLUSIVE ["%S --- Berechnung 02, ToolXPos01 = %Fmm, ToolYPos01 = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.E.ToolPos[1].X, V.E.ToolPos[1].Y]

; Berechnung 03, Verschiebungsvektor fuer die Werkzeugplätze 2-14
V.L.ShiftVectorRow[0] = COS[V.L.AngleXY] * V.L.IntervalTX
V.L.ShiftVectorRow[1] = SIN[V.L.AngleXY] * V.L.IntervalTX
#MSG SAVE EXCLUSIVE ["%S --- Berechnung 03, XVerschiebung = %Fmm, YVerschiebung = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.ShiftVectorRow[0], V.L.ShiftVectorRow[1]]

; Berechnung 04, WZ-Platz15-Position berechnen, auf Basis von WZ-Platz1
V.E.ToolPos[V.L.StartPlaceRow[1]].X = V.E.ToolPos[1].X - SIN[V.L.AngleXY] * 2 * V.L.ReferenceDistanceTY
V.E.ToolPos[V.L.StartPlaceRow[1]].Y = V.E.ToolPos[1].Y - COS[V.L.AngleXY] * 2 * V.L.ReferenceDistanceTY
#MSG SAVE EXCLUSIVE ["%S --- Berechnung 04, ToolXPos14 = %Fmm, ToolYPos14 = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.E.ToolPos[V.L.StartPlaceRow[1]].X, V.E.ToolPos[V.L.StartPlaceRow[1]].Y]

; Berechnung 05, Positionen der restlichen WZ-Plätze --> 28
$FOR P1=1,V.L.ToolsInRow-1,1
	; Reihe 1 Werkzeugplätze 1-14
	V.E.ToolPos[P1+V.L.StartPlaceRow[0]].X = V.E.ToolPos[V.L.StartPlaceRow[0]].X + V.L.ShiftVectorRow[0] * P1
	V.E.ToolPos[P1+V.L.StartPlaceRow[0]].Y = V.E.ToolPos[V.L.StartPlaceRow[0]].Y + V.L.ShiftVectorRow[1] * P1
	; Reihe 2 Werkzeugplätze 15-28
	V.E.ToolPos[P1+V.L.StartPlaceRow[1]].X = V.E.ToolPos[V.L.StartPlaceRow[1]].X + V.L.ShiftVectorRow[0] * P1
	V.E.ToolPos[P1+V.L.StartPlaceRow[1]].Y = V.E.ToolPos[V.L.StartPlaceRow[1]].Y + V.L.ShiftVectorRow[1] * P1
$ENDFOR

$IF V.L.CalcBlanlkPos == TRUE
   ; Berechnung 06, Position Blank-Platz1
   V.L.DistanceVectorB = SQRT[SQR[V.L.ReferenceDistanceBX] + SQR[V.L.ReferenceDistanceBY]]
   V.L.AngleToBP1 = ATAN[V.L.ReferenceDistanceBX/V.L.ReferenceDistanceBY] - V.L.AngleXY
   #MSG SAVE EXCLUSIVE ["%S --- Berechnung 06, Vector = %Fmm, Winkel = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.DistanceVectorB, V.L.AngleToBP1]  
   V.L.DeltaXYBP1[0] = SIN[V.L.AngleToBP1] * V.L.DistanceVectorB
   V.L.DeltaXYBP1[1] = COS[V.L.AngleToBP1] * V.L.DistanceVectorB
   #MSG SAVE EXCLUSIVE ["%S --- Berechnung 06, deltaX = %Fmm, deltaY = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.DeltaXYBP1[0], V.L.DeltaXYBP1[1]] 
   
   V.E.BlankPos[1].X = V.E.ToolPos[1].X + V.L.DeltaXYBP1[0]
   V.E.BlankPos[1].Y = V.E.ToolPos[1].Y + V.L.DeltaXYBP1[1]
   #MSG SAVE EXCLUSIVE ["%S --- Berechnung 02, BlankXPos01 = %Fmm, BlankYPos01 = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.E.BlankPos[0].X, V.E.BlankPos[1].Y]
   
   ; Berechnung 07, Verschiebungsvektor fuer Blank-Plätze 2-7
   V.L.ShiftVectorRowB[0] = COS[V.L.AngleXY] * V.L.IntervalBX
   V.L.ShiftVectorRowB[1] = SIN[V.L.AngleXY] * V.L.IntervalBX
   #MSG SAVE EXCLUSIVE ["%S --- Berechnung 07, XVerschiebung = %Fmm, YVerschiebung = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.ShiftVectorRowB[0], V.L.ShiftVectorRowB[1]]
   
   ; Berechnung 08, Positionen der restlichen Blank-Plätze --> 7
   $FOR P1=1,V.L.BlanksInRow-1,1
   	; Reihe 1 Werkzeugplätze 1-14
   	V.E.BlankPos[P1+1].X = V.E.BlankPos[1].X + V.L.ShiftVectorRowB[0] * P1
   	V.E.BlankPos[P1+1].Y = V.E.BlankPos[1].Y + V.L.ShiftVectorRowB[1] * P1
   $ENDFOR
$ENDIF


#FLUSH WAIT
$GOTO [Label_Ende]

