( --------------- Unterprogramm Kreismittelpunkt Messung ------------- )
%L UP_FindCenterPoint

; -------------- Hoehe des Messzapfens bestimmen
#MEAS MODE [5]
G310 G01 X=V.L.XYZPos[0] Y=V.L.XYZPos[1] FV.E.FEEDSLOW $GOTO [Label_Crash]
G310 G01 Z=V.L.XYZPos[2]+20 $GOTO [Label_Crash]


#MEAS MODE [1]
G100 Z=V.L.XYZPos[2]-1 FV.E.FEEDMEASURE		; Zmin beim Messen
$IF V.A.MERF.Z == TRUE
	V.L.tmpMPZ = V.A.MESS.Z - V.G.WZ_AKT.L
	#MSG SAVE EXCLUSIVE ["%S --- Messzapfen %U Z-Hoehe = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.No, V.L.tmpMPZ]
	#MSG SYN HMI ["Messzapfen %U Z-Hoehe = %Fmm", V.L.No, V.L.tmpMPZ]
$ELSE
	$GOTO [Label_NoValue]
$ENDIF

G01 Z=V.L.tmpMPZ+10 FV.E.FEEDSLOW		; Ausheben in Z

; -------------- erster Messpunkt fuer Mittelpunktbestimmung
#MEAS MODE [5]
G310 G01 X=V.L.XYZPos[0]-V.L.XYOffset FV.E.FEEDSLOW $GOTO [Label_Crash]
G310 G01 Z=V.L.tmpMPZ-5 FV.E.FEEDSLOW $GOTO [Label_Crash]
V.L.tmpPos = V.A.ACT_POS.X	; X-Position auf Variable speichern
#FLUSH WAIT

#MEAS MODE [1]
G100 X=V.L.XYZPos[0]-V.L.BasisDiameter/2 FV.E.FEEDMEASURE	; Messen in X-Richtung
G01 X=V.L.tmpPos FV.E.FEEDMEASURE
#FLUSH WAIT
$IF V.A.MERF.X == TRUE
	V.L.tmpMPs[0][0] = V.A.MESS.X
	V.L.tmpMPs[0][1] = V.A.ACT_POS.Y
	#MSG SAVE EXCLUSIVE ["%S --- Messzapfen %U Messwert01 = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.No, V.L.tmpMPs[0][0]]
	#MSG SYN HMI ["Messzapfen %U Messwert01 = %Fmm", V.L.No, V.L.tmpMPs[0][0]]
$ELSE
	$GOTO [Label_NoValue]
$ENDIF
#FLUSH WAIT

; -------------- zweiter Messpunkt fuer Mittelpunktbestimmung
#MEAS MODE [5]
G310 G01 Z=V.L.tmpMPZ+V.L.XYOffset FV.E.FEEDMEASURE $GOTO [Label_Crash]
G310 G01 X=V.L.XYZPos[0]+V.L.XYOffset FV.E.FEEDMEASURE $GOTO [Label_Crash]
G310 G01 Z=V.L.tmpMPZ-5 FV.E.FEEDSLOW $GOTO [Label_Crash]
V.L.tmpPos = V.A.ACT_POS.X	; X-Position auf Variable speichern
#FLUSH WAIT

#MEAS MODE [1]
G100 X=V.L.XYZPos[0]+V.L.BasisDiameter/2 FV.E.FEEDMEASURE	; Messen in X-Richtung
G01 X=V.L.tmpPos FV.E.FEEDMEASURE
#FLUSH WAIT
$IF V.A.MERF.X == TRUE
	V.L.tmpMPs[1][0] = V.A.MESS.X
	V.L.tmpMPs[1][1] = V.A.ACT_POS.Y
	#MSG SAVE EXCLUSIVE ["%S --- Messzapfen %U Messwert02 = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.No, V.L.tmpMPs[1][0]]
	#MSG SYN HMI ["Messzapfen %U Messwert02 = %Fmm", V.L.No, V.L.tmpMPs[1][0]]
$ELSE
	$GOTO [Label_NoValue]
$ENDIF
#FLUSH WAIT

; -------------- dritter Messpunkt fuer Mittelpunktbestimmung
#MEAS MODE [5]
G310 G01 Z=V.L.tmpMPZ+V.L.XYOffset FV.E.FEEDMEASURE $GOTO [Label_Crash]
G310 G01 X=V.L.XYZPos[0] FV.E.FEEDMEASURE $GOTO [Label_Crash]
G310 G01 Y=V.L.XYZPos[1]+V.L.XYOffset FV.E.FEEDMEASURE $GOTO [Label_Crash]
G310 G01 Z=V.L.tmpMPZ-5 FV.E.FEEDSLOW $GOTO [Label_Crash]
V.L.tmpPos = V.A.ACT_POS.Y	; Y-Position auf Variable speichern
#FLUSH WAIT

#MEAS MODE [1]
G100 Y=V.L.XYZPos[1]-V.L.BasisDiameter/2 FV.E.FEEDMEASURE	; Messen in X-Richtung
G01 Y=V.L.tmpPos FV.E.FEEDMEASURE
#FLUSH WAIT
$IF V.A.MERF.Y == TRUE
	V.L.tmpMPs[2][0] = V.A.ACT_POS.X
	V.L.tmpMPs[2][1] = V.A.MESS.Y
	#MSG SAVE EXCLUSIVE ["%S --- Messzapfen %U Messwert03 = %Fmm", V.G.TIME_STAMP_FILE_NAME, V.L.No, V.L.tmpMPs[2][1]]
	#MSG SYN HMI ["Messzapfen %U Messwert03 = %Fmm", V.L.No, V.L.tmpMPs[2][1]]
$ELSE
	$GOTO [Label_NoValue]
$ENDIF
#FLUSH WAIT

G01 Z=V.L.tmpMPZ+20 FV.E.FEEDSLOW
#MEAS MODE [5]
G310 G01 Y=V.L.XYZPos[1]
$GOTO [Label_END]

; ----------------------------------------------------------------------------------------------------------
; -- Sprungmarke wird verwendet, wenn während der eigentlichen Positionierung der 3D-Messtaster ausgelöst hat
[Label_Crash]
	#MSG SAVE EXCLUSIVE ["%S --- Während der Positionierung wurde der 3D-Messtaster ausgelöst", V.G.TIME_STAMP_FILE_NAME]
	#MSG SYN HMI ["Während der Positionierung wurde der 3D-Messtaster ausgelöst"]
	V.E.MessageNumber = 420	; CRASH mit 3D-Taster
	M199
	#FLUSH WAIT
; ----------------------------------------------------------------------------------------------------------
; -- Sprungmarke wird verwendet, wenn während der Messwertermittlung kein Messwert ermittelt wurde
[Label_NoValue]
	V.E.MessageNumber = 499	; Es wurde kein Messwert ermittelt
	#MCS ON EX TOOL
	G01 Z=V.A.+SWE.Z-1 FV.E.FEEDSLOW	;Z hoch
	#MCS OFF
	#MEAS MODE [5]
	$IF ABS[V.A.ACT_POS.X] > 1
		G310 G01 X0 FV.E.FEEDSLOW $GOTO [Label_MainCrash]
	$ENDIF
	$IF ABS[V.A.ACT_POS.Y] > 1
		G310 G01 Y0 FV.E.FEEDSLOW $GOTO [Label_MainCrash]
	$ENDIF

	
	#MSG SYN HMI ["Warte auf Wechslerklappe geschlossen"]
	M62	; Wechslerklappe schließen
	M50   ; Loadertuer entriegeln
	#MSG SYN HMI ["Warte 3D-Messtaster ausgeschaltet"]
	M39	; 3D-Messtaster ausschalten	
	#MSG SYN HMI [""]
	M199
	#FLUSH WAIT
; ----------------------------------------------------------------------------------------------------------


[Label_END]

M17


( --------------- Unterprogramm Kreismittelpunkt Berechnen ------------- )
%L UP_CalcCenterPoint
P11 = V.L.tmpMPs[0][0]	;X1
P12 = V.L.tmpMPs[0][1]	;Y1
P21 = V.L.tmpMPs[1][0]	;X2
P22 = V.L.tmpMPs[1][1]	;Y2
P31 = V.L.tmpMPs[2][0]	;X3
P32 = V.L.tmpMPs[2][1]	;Y3
P40 = 2 * [P11 * [P22 - P32] + P21 * [P32 - P12] + P31 * [P12 - P22]]
V.L.CalculatedCenter[0] = [[P11 * P11 + P12 * P12] * [P22 - P32] + [P21 * P21 + P22 * P22] * [P32 - P12] + [P31 * P31 + P32 * P32] * [P12 - P22]] / P40
V.L.CalculatedCenter[1] = [[P11 * P11 + P12 * P12] * [P31 - P21] + [P21 * P21 + P22 * P22] * [P11 - P31] + [P31 * P31 + P32 * P32] * [P21 - P11]] / P40

M17





