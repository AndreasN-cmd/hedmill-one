;													#MSG SYN HMI["Beim Ablegen auf Rundwechsler-Pos %U ist ein Fehler aufgetreten, Preformhalter eventuell noch in der Maschine", V.P.BlankPosToCheck]
;													$IF EXIST[V.E.MessageText] == TRUE
;														V.E.MessageText = "Beim Ablegen auf Rundwechsler-Pos " + INT_TO_STR[V.P.BlankPosToCheck] + " ist ein Fehler aufgetreten!"
;														V.E.MessageNumber = 900	; Fehlermeldung in SPS erzeugen mit Text aus V.E.MessageText
;													$ENDIF
;													M199
