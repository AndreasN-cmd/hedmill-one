(-----------------------------------------------------------------------------------)
(----- einen Blank aus dem Wechsler in das B-Achsenullpunktspannsystem bringen -----)
(-----------------------------------------------------------------------------------)
[Label_Load]
$IF V.E.BlankRequest.Pos <= 0 
	$GOTO [Label_End]
$ENDIF


; Haltertyp aus Artikelnummer bestimmen
$IF V.E.BlankRequest.Pos != 0
	V.L.PointPos = FIND[V.E.BlankRequest.Name, "."] + 1
	V.L.HolderTypSTR = MID[V.E.BlankRequest.Name,1,V.L.PointPos]	; das erste Zeichen hinter dem "." auslesen
	$IF V.L.HolderTypSTR == "C"
			V.L.HolderTypC = 6	; C-Halter in (M)aschine
		$ELSE
			V.L.HolderTypC = STR_TO_INT[MID[V.E.BlankRequest.Name,1,V.L.PointPos]] ; erste Ziffer der Artikelnummer auslesen 1-7=Blank 8-9=Preform
			$IF V.L.HolderTypC >= 1 AND V.L.HolderTypC <= 7 
					V.L.HolderTypC = 1	; Blankhalter in (C)hanger
				$ELSEIF V.L.HolderTypC >= 8 AND V.L.HolderTypC <= 9
					V.L.HolderTypC = 2	; Preformhalter in (C)hanger
				$ELSE
			V.E.MessageText = "Artikelnummer des Materials im Wechsler (Position " + INT_TO_STR[V.E.BlankRequest.Pos] + ") ist nicht richtig definiert"
					#MSG SAVE EXCLUSIVE ["%S --- %S", V.G.TIME_STAMP_FILE_NAME, V.E.MessageText]
					#MSG SYN HMI ["%S", V.E.MessageText]
					V.E.MessageNumber = 900	; Fehlermeldung in SPS erzeugen mit Text aus V.E.MessageText
					M199
			$ENDIF
	$ENDIF
$ENDIF


V.P.ExpectedBlankTyp = V.L.HolderTypC	; = 1; 2; 6
V.P.BlankPosToCheck = V.E.BlankRequest.Pos

$IF V.L.DontUseLaser == 0	; der Laser wird fuer die ueberpruefung der Blanks verwendet
		$IF V.P.BlankPosToCheck >= V.L.BCMinValue AND V.P.BlankPosToCheck <= V.L.BCMaxValue
				L checkBlankAtPos
			$ELSEIF V.P.BlankPosToCheck >= V.L.RotaryBCMinValue AND V.P.BlankPosToCheck <= V.L.RotaryBCMaxValue AND V.P.ExpectedBlankTyp != 6
				L checkBlankAtPosRC
			$ELSEIF V.P.BlankPosToCheck >= V.L.RotaryBCMinValue AND V.P.BlankPosToCheck <= V.L.RotaryBCMaxValue AND V.P.ExpectedBlankTyp == 6
				$GOTO [Label_GET]
		$ENDIF
		#FLUSH WAIT


		$IF NOT [V.P.BlankPosChecked == V.L.HolderTypC] AND NOT [V.P.BlankPosChecked == 3 AND V.L.HolderTypC == 2]		; gesuchtes nicht auf gepruefter Position
			V.L.TrialsFindBlank = V.L.TrialsFindBlank + 1
			LL UP_SafeAndWait
			#MSG SAVE EXCLUSIVE ["%S --- Gewuenschtes Material nicht an definierter Wechsler-Position %U, bitte pruefen!", V.G.TIME_STAMP_FILE_NAME, V.E.BlankRequest.Pos]    
			#MSG SYN HMI ["Gewuenschtes Material nicht an definierter Wechsler-Position %U, bitte pruefen!", V.E.BlankRequest.Pos]
			V.E.MessageNumber = 617 (Gewuenschtes Material nicht an definierter Wechsler-Position, bitte pruefen!)
			M199=1
			M0		; warten auf Start/Weiter
			#FLUSH WAIT
			V.E.MessageNumber = 0	; Meldung zurueck setzen
			
			LL UP_CheckBeforeStart	; Wechsler-Kassette und Loadertuer pruefen
			$GOTO [Label_Load]
		$ENDIF 
	$ELSE
		V.P.BlankPosChecked = V.L.HolderTypC
$ENDIF

[Label_GET]
L getBlankFromChanger
L giveBlankInB

; pruefen ob der Blank im Nullpunktspannsystem ist
(=== 1.2.7 VORSCHLAG === NEU: Kontrolle nur wenn der Laser genutzt wird ===========)
$IF V.L.DontUseLaser == 0
	L checkBlankInB
	#FLUSH WAIT	; NEU, fehlte hier
	(==================================================================================)
	$IF V.P.BlankPosChecked != V.L.HolderTypC
			; beim Ablegen ist ein Fehler aufgetreten, eventuell ist der Blankhalter noch in der Maschine
			#MSG SAVE EXCLUSIVE ["%S --- Beim Ablegen ist ein Fehler aufgetreten, Blankhalter eventuell noch im Wechsler Pos %U", V.G.TIME_STAMP_FILE_NAME, V.P.BlankPosToCheck]   
			#MSG SYN HMI["Beim Ablegen ist ein Fehler aufgetreten, Blankhalter eventuell noch im Wechsler Pos %U", V.P.BlankPosToCheck]
			$IF EXIST[V.E.MessageText] == TRUE
				V.E.MessageText = "Beim Ablegen ist ein Fehler aufgetreten, Blankhalter eventuell noch im Wechsler Pos " + INT_TO_STR[V.P.BlankPosToCheck]
				V.E.MessageNumber = 900	; Fehlermeldung in SPS erzeugen mit Text aus V.E.MessageText
			$ENDIF
			M199
		$ELSE
			#MSG SAVE EXCLUSIVE ["%S --- Blankhalter erfolgreich im Nullpunktspannsystem abgelegt", V.G.TIME_STAMP_FILE_NAME]   
			#MSG SYN HMI["Blankhalter erfolgreich im Nullpunktspannsystem abgelegt"]
	 $ENDIF
	(=== 1.2.7 VORSCHLAG ==============================================================)
$ENDIF	; V.L.DontUseLaser == 0
(==================================================================================)
(-----------------------------------------------------------------------------------)



[Label_End]

V.E.FunctionNumber = 6000
V.E.FunctionValue = -1	; Blank-Platz im Wechsler

#FLUSH WAIT
V.E.BlankChangeActiveNo = 0

#HSC OFF
#MCS ON EX TOOL

L ToolWeightOff	; Werkzeugstandzeitgewichtung deaktivieren
G01 Z=V.A.+SWE.Z-1 FV.E.FEEDMAX	;Z hoch
G01 X-120 
L SAFEPOS	; alle Achsen auf sichere Position fahren

#MSG SYN HMI ["Warte auf Wechslerklappe geschlossen"]
M62	; Wechslerklappe schließen
#MSG SYN HMI [""]


$IF V.E.BlankInMachine.Pos > 0 
	$IF V.P.IBNactive == FALSE	; nur pruefen, wenn das IBN-Flag zurueck gesetzt wurde
		L AB-Null	; pruefen ob die AB-Achsen gerade ist
	$ENDIF

	;L checkBlankHeight		; die Blankhoehe pruefen soll=ist 

	; wenn Blankhoehe nicht stimmt, wieder zurueck bringen
$ENDIF

M107	; Absaugung aus
   V.P.BlankchangeDone = 1

#MSG SAVE EXCLUSIVE ["%S --- BlankChange wurde abgearbeitet", V.G.TIME_STAMP_FILE_NAME]
#FLUSH WAIT

#MCS OFF
#HSC ON

M17
(--------------------------- Blankwechsel-Ablauf ENDE -----------------------)
