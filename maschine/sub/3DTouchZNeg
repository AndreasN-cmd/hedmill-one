(-------------------- 3D-Messpunkt X+ ermitteln ------------------)

(--Beschreibung-------------------------------------------------------------)
;  Mit diesem Programm wird ein Messpunkt mit dem 3D-Taster in 
;  positiver Y-Richtung bestimmt
;
;	Version		Datum 		SYN HMI 				Aenderungen
;	1.0.0		26.09.2025	H.-J. Albrecht		Programmerstellung   
;	1.0.1		14.07.2026	H.-J. Albrecht		SYN PLC in SYN HMI geändert
;
; Auslieferungsversion 1.0.0         
(---------------------------------------------------------------------------)
#VAR
   V.L.DistanceZ = -10      ; Messdistanz
   V.L.ActPosZ
#ENDVAR  
   
G90   
#HSC OFF
#MEAS [TYPE=1 EDGE=NEG INPUT=2]	; Umschaltung der Messsignalauswertung 

T9999 
D9999	; T- und D-Nummer 3D-Messtaster


#MSG SYN HMI ["Warte 3D-Messtaster eingeschaltet"]
M38	; 3D-Messtaster einschalten
G04 1
#FLUSH WAIT
#MSG SYN HMI [""]


V.L.ActPosZ = V.A.ACT_POS.Z
G100 Z=V.L.ActPosZ + V.L.DistanceZ FV.E.FEEDMEASURE	
G01 Z=V.L.ActPosZ FV.E.FEEDFAST		; Rückzug auf Startposition
	
$IF V.A.MERF.Z == TRUE
		#MSG SAVE EXCLUSIVE ["%S --- pos. Z-Messung, Messwert = %Fmm", V.G.TIME_STAMP_FILE_SYN HMI, V.A.MESS.Z]    
		#MSG SYN HMI ["pos. Z-Messung, Messwert = %Fmm", V.A.MESS.Z]
	$ELSE
		#MSG SAVE EXCLUSIVE ["%S --- pos. Z-Messung, kein Messwert", V.G.TIME_STAMP_FILE_SYN HMI]    
		#MSG SYN HMI ["pos. Z-Messung, kein Messwert"]
$ENDIF

#FLUSH WAIT
M39	; 3D-Messtaster ausschalten
M17
(-------------------- X-Nullpunkt B0 ermitteln ------------------)
