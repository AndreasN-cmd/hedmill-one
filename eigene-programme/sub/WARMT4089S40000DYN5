; WARMT4089S40000DYN5 - Warmlauf 4 min + Nachmessen fuer Drehfraesstrategien (Spindelwaerme), Version 2
; Werkzeug T4089, Drehzahl 40000, Dynamiksatz LDYN5. 2026-11-12 (Andreas/Claude).
; Aufruf: NC-Text 'nach Werkzeugwechsel' im hyperDENT-Job (L WARMT4089S40000DYN5). Der Postprozessor setzt ihn
; nach 'T4089 M6' und 'LDYN5', vor 'S40000 M3'. Danach schaltet der PP Spindel und Luft selbst wieder ein.
; Messen mit dem Hersteller-measureTool erst nach M5 + 3 s (measureTool macht selbst nochmal M5).
; Ohne zweites M6, damit cleanWS (Reinigungsfahrt) entfaellt. Rueckweg: Version 1 mit 'T.. M6'.
; Quelle: ../fraesstrategien-hyperdent/docs/drehfraesen_spindelwaerme.md, tools/warmlauf_unterprogramme.py
$IF V.G.T_AKT != 4089 OR V.E.ToolInSpindle.Basic != 4089
   #MSG SYN HMI ["WARMT4089S40000DYN5: falsches Werkzeug in der Spindel - Abbruch"]
   #MSG SAVE EXCLUSIVE ["%S --- WARMT4089S40000DYN5: falsches Werkzeug T%D in der Spindel - Abbruch", V.G.TIME_STAMP_FILE_NAME, V.E.ToolInSpindle.Basic]
   M5
   M199
$ENDIF
#MSG SAVE EXCLUSIVE ["%S --- WARMT4089S40000DYN5: Warmlauf 4 min Start, Laenge aktiv %Fmm", V.G.TIME_STAMP_FILE_NAME, V.G.WZ_AKT.L]
S40000 M3
M119 ; Spindel EIN -> Spindelluft EIN
G04 240
M5
M118 ; Spindel AUS -> Spindelluft AUS
G04 3
V.G.WZ_AKT.P[0] = 0 ; measureTool speichert die Laenge (Vollmessung, wie Refresh)
L measureTool ; Hersteller: M5, M9, Klappe auf, Z hoch, A0 B0, Taster, Laenge, Werkzeugdaten
#FLUSH WAIT
$IF V.E.ToolInvalid != 0 OR V.E.ToolInSpindle.Basic != 4089 OR V.G.WZ_AKT.L < 15
   #MSG SYN HMI ["WARMT4089S40000DYN5: Nachmessen nicht in Ordnung - Abbruch"]
   #MSG SAVE EXCLUSIVE ["%S --- WARMT4089S40000DYN5: Nachmessen nicht in Ordnung - Abbruch", V.G.TIME_STAMP_FILE_NAME]
   M199
$ENDIF
#TOOL PREP [V.E.ToolInSpindle.Basic, V.E.ToolInSpindle.Sister, V.E.ToolInSpindle.Variant]
#TOOL DATA [V.E.ToolInSpindle.Basic, V.E.ToolInSpindle.Sister, V.E.ToolInSpindle.Variant]
#MEAS DEFAULT
L SAFEPOS
#MSG SYN HMI ["Warte auf Wechslerklappe geschlossen"]
M62 ; Wechslerklappe schliessen (measureTool hat sie geoeffnet)
#MSG SYN HMI [""]
M50 ; Loadertuer entriegeln (wie Ende M6)
V.E.ToolChangeActiveNo = 0
LDYN5
#FLUSH WAIT
#MSG SAVE EXCLUSIVE ["%S --- WARMT4089S40000DYN5: warm nachgemessen, Laenge aktiv %Fmm", V.G.TIME_STAMP_FILE_NAME, V.G.WZ_AKT.L]
M17
